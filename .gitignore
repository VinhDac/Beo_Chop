# Môi trường
.venv/
__pycache__/
*.pyc
# Dự án KHÔNG dùng pytest (bộ kiểm là script chạy qua `tests/chay_tat_ca.py`) — thư mục
# này là rác còn lại từ một lần chạy pytest cũ. Nó tự giấu bằng `.gitignore` riêng bên
# trong, nên `git status` không hề kêu; khai ở đây để lần sau thấy ngay.
.pytest_cache/

# Sinh ra lúc chạy, cạnh app — không thuộc về repo
du_lieu/
settings.json
templates/

# Khoá API QuantConnect (D-06) — toàn quyền tài khoản. Chỗ đúng của nó là
# du_lieu/qc_khoa.json (đã bị `du_lieu/` chặn); dòng này chặn cả khi lỡ đặt chỗ khác.
qc_khoa.json

# Shortcut do tools/tao_shortcut.bat sinh ra — chứa đường dẫn tuyệt đối của máy này
Cat Studio.lnk

# Thư mục làm việc của Claude Code. Trong đó có cả WORKTREE — một bản sao đầy đủ
# của chính kho này — nên để lọt vào `git add` là kho tự nuốt chính nó. Chừa đúng
# `launch.json`: nó khai cách bật máy chủ xem thử, việc của repo chứ không của máy.
.claude/*
!.claude/launch.json

# Build
webui/node_modules/
webui/dist/
build/
dist/
*.spec.bak
# Shortcut/bản phát hành sinh ra tại máy — không vào repo.
# (Bản .zip nằm trong dist/ nên đã bị dist/ ở trên nuốt rồi.)

# Ảnh chụp giao diện QuantConnect — tham chiếu để dựng màn Kết quả (D-17) và màn
# Optimize. Giữ ở máy thì được; đẩy lên kho là phát tán ảnh sản phẩm của họ.
tai_lieu/backtest/
tai_lieu/optimize/

# Chiến thuật ví dụ lấy từ web — tham chiếu để dựng lại (D-18).
# Giữ ở máy thì được; đẩy lên kho là mang mã của người khác vào hồ sơ của mình.
tai_lieu/chiến thuật ví dụ/
